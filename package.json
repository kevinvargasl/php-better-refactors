{
  "name": "php-better-refactors",
  "displayName": "PHP Better Refactors",
  "description": "PSR-4-aware PHP refactoring: automatic class/file/namespace, properties and methods renaming and cross-project reference updates",
  "version": "0.3.2",
  "publisher": "kevinvargasl",
  "license": "MIT",
  "icon": "assets/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/kevinvargasl/php-better-refactors"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:**/composer.json"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "phpBetterRefactors.reindex",
        "title": "PHP Better Refactors: Rebuild Index"
      }
    ],
    "configuration": {
      "title": "PHP Better Refactors",
      "properties": {
        "phpBetterRefactors.enableAutoRename": {
          "type": "boolean",
          "default": true,
          "description": "Automatically rename class when file is renamed"
        },
        "phpBetterRefactors.enableAutoNamespace": {
          "type": "boolean",
          "default": true,
          "description": "Automatically update namespace when file is moved"
        },
        "phpBetterRefactors.excludePatterns": {
          "type": "array",
          "default": [
            "**/vendor/**",
            "**/node_modules/**",
            "**/storage/**",
            "**/.phpunit.cache/**",
            "**/.phpstan/**",
            "**/.php-cs-fixer.cache/**"
          ],
          "items": {
            "type": "string"
          },
          "description": "Patterns for files/folders to exclude from reference scanning"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "node esbuild.mjs --watch",
    "package": "node esbuild.mjs --production",
    "lint": "eslint src",
    "test": "npm run compile && npm run package && npm run test:unit && npm run test:integration:run",
    "test:unit": "mocha ./out/test/unit/**/*.test.js",
    "test:integration": "npm run compile && npm run package && npm run test:integration:run",
    "test:integration:run": "node ./out/test/runTests.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.1",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.4.0",
    "mocha": "^11.7.6",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3"
  },
  "dependencies": {
    "minimatch": "^9.0.9",
    "php-parser": "^3.6.0"
  }
}
